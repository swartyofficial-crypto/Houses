local function GetKnifeRemote()
    if knifeRemote then return knifeRemote end
    local clientRemotes = LocalPlayer:FindFirstChild("ClientRemotes")
    if clientRemotes then
        knifeRemote = clientRemotes:FindFirstChild("KnifeThrow")
        return knifeRemote
    end
    return nil
end

local function GetMapPart()
    if mapPart then return mapPart end
    local success, result = pcall(function()
        return workspace._G.MilBase.Map_MilitaryBase:GetChildren()[627]
    end)
    if success and result then
        mapPart = result
        return mapPart
    end
    for _, child in pairs(workspace:GetDescendants()) do
        if child:IsA("Part") and child.Name ~= "" then
            mapPart = child
            return child
        end
    end
    return nil
end

local function ThrowKnife(targetPos)
    local remote = GetKnifeRemote()
    if not remote then return false end
    local character = LocalPlayer.Character
    if not character then return false end
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return false end

    local origin = root.Position + Vector3.new(0, 1.5, 0)
    local lookAt = CFrame.lookAt(origin, targetPos)
    local handle = GetMapPart()
    if not handle then return false end

    remote:InvokeServer(lookAt, targetPos, "Sakura", handle)
    return true
end

-- AURA (360°)
local function ThrowAura()
    local count = Settings.Count
    local radius = 50
    local origin = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not origin then return end
    origin = origin.Position + Vector3.new(0, 1.5, 0)

    for i = 0, count - 1 do
        local angle = (i / count) * 2 * math.pi
        local x = origin.X + radius * math.cos(angle)
        local z = origin.Z + radius * math.sin(angle)
        local y = origin.Y + math.random(-3, 3)
        ThrowKnife(Vector3.new(x, y, z))
        task.wait(Settings.Speed)
    end
end

-- DIRECTION (baktığın yöne – düzgün)
local function ThrowDirection()
    local count = Settings.Count
    local origin = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not origin then return end
    origin = origin.Position + Vector3.new(0, 1.5, 0)

    local look = Camera.CFrame.LookVector
    local spread = 10 -- derece (dar açı)
    local up = Vector3.new(0, 1, 0)
    local right = look:Cross(up).Unit
    if right.Magnitude < 0.01 then right = Vector3.new(1,0,0) end
    up = right:Cross(look).Unit

    for i = 0, count - 1 do
        local angle = math.rad((i / (count - 1)) * spread * 2 - spread)
        local dir = (look + right * math.sin(angle) + up * math.cos(angle) * 0.2).Unit
        local targetPos = origin + dir * 50
        ThrowKnife(targetPos)
        task.wait(Settings.Speed)
    end
end

-- RANDOM
local function ThrowRandom()
    local count = Settings.Count
    local origin = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not origin then return end
    origin = origin.Position + Vector3.new(0, 1.5, 0)

    for i = 1, count do
        local dir = Vector3.new(
            math.random(-100, 100) / 100,
            math.random(-30, 50) / 100,
            math.random(-100, 100) / 100
        ).Unit
        local targetPos = origin + dir * 50
        ThrowKnife(targetPos)
        task.wait(Settings.Speed)
    end
end

local function KnifeLoop()
    if not Settings.KnifeAura then
        auraRunning = false
        return
    end
    if auraRunning then return end
    auraRunning = true

    task.spawn(function()
        while Settings.KnifeAura do
            if Settings.Mode == "Aura" then
                ThrowAura()
            elseif Settings.Mode == "Direction" then
                ThrowDirection()
            elseif Settings.Mode == "Random" then
                ThrowRandom()
            end
            task.wait(0.3)
        end
        auraRunning = false
    end)
end

