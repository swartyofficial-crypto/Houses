--// ========== UTILITY ========== //

local function GetTorso(character)
    if not character then return nil end
    return character:FindFirstChild("HumanoidRootPart")
        or character:FindFirstChild("Torso")
        or character:FindFirstChild("UpperTorso")
        or character:FindFirstChild("Head")
end

local function FindWeaponRemote()
    local character = LocalPlayer.Character
    if not character then return nil, nil end

    local function searchRemote(obj)
        for _, child in pairs(obj:GetChildren()) do
            if child:IsA("RemoteEvent") then
                local name = child.Name:lower()
                if name:find("shot") or name:find("shoot") or name:find("fire") or name:find("gun") or name:find("attack") then
                    return child
                end
            end
            local found = searchRemote(child)
            if found then return found end
        end
        return nil
    end

    for _, tool in pairs(character:GetChildren()) do
        if tool:IsA("Tool") then
            local remote = searchRemote(tool)
            if remote then return remote, tool end
        end
    end

    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if backpack then
        for _, tool in pairs(backpack:GetChildren()) do
            if tool:IsA("Tool") then
                local remote = searchRemote(tool)
                if remote then return remote, tool end
            end
        end
    end
    return nil, nil
end

local function IsVisible(targetPos)
    local origin = Camera.CFrame.Position
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Blacklist
    params.FilterDescendantsInstances = {LocalPlayer.Character}
    params.IgnoreWater = true

    local result = workspace:Raycast(origin, (targetPos - origin).Unit * 500, params)
    if result then
        local dist = (result.Position - targetPos).Magnitude
        return dist < 4
    end
    return true
end

--// ========== AIMBOT ========== //

local function GetClosestPlayer()
    local closest = nil
    local shortestDist = math.huge
    local cameraPos = Camera.CFrame.Position
    local cameraLook = Camera.CFrame.LookVector
    local viewport = Camera.ViewportSize

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local humanoid = player.Character:FindFirstChild("Humanoid")
            local torso = GetTorso(player.Character)
            if humanoid and humanoid.Health > 0 and torso then
                local pos = torso.Position
                local dir = (pos - cameraPos).Unit
                if cameraLook:Dot(dir) > 0.1 then
                    local screenPos, onScreen = Camera:WorldToScreenPoint(pos)
                    if onScreen then
                        local center = Vector2.new(viewport.X/2, viewport.Y/2)
                        local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                        local worldDist = (pos - cameraPos).Magnitude
                        local weighted = dist + worldDist * 0.3
                        if weighted < shortestDist then
                            shortestDist = weighted
                            closest = player
                        end
                    end
                end
            end
        end
    end

    if closest and closest.Character then
        local torso = GetTorso(closest.Character)
        if torso then
            local currentPos = torso.Position
            table.insert(lastPositions, {pos = currentPos, time = tick()})
            if #lastPositions > 10 then table.remove(lastPositions, 1) end
            if #lastPositions >= 3 then
                local newest = lastPositions[#lastPositions]
                local oldest = lastPositions[#lastPositions - 2]
                local dt = newest.time - oldest.time
                if dt > 0.01 then
                    local rawVel = (newest.pos - oldest.pos) / dt
                    table.insert(velocityHistory, rawVel)
                    if #velocityHistory > 5 then table.remove(velocityHistory, 1) end
                    if #velocityHistory >= 3 then
                        local totalWeight = 0
                        local weightedSum = Vector3.new(0,0,0)
                        for i, vel in ipairs(velocityHistory) do
                            local weight = i / #velocityHistory
                            weightedSum = weightedSum + vel * weight
                            totalWeight = totalWeight + weight
                        end
                        targetVelocity = weightedSum / totalWeight
                    else
                        targetVelocity = rawVel
                    end
                end
            end
        end
    else
        targetVelocity = Vector3.new(0,0,0)
        lastPositions = {}
        velocityHistory = {}
    end

    return closest
end

local function GetPredictedPosition(target)
    if not target or not target.Character then return nil end
    local torso = GetTorso(target.Character)
    if not torso then return nil end
    local currentPos = torso.Position
    if not Settings.AutoPrediction then return currentPos end

    local predicted = currentPos + targetVelocity * Settings.LeadTime
    if Settings.JumpPrediction and targetVelocity.Y > 15 then
        predicted = predicted + Vector3.new(0, Settings.JumpOffset, 0)
    end
    return predicted
end

local function FireAtTarget(target)
    local remote = FindWeaponRemote()
    if not remote then return false end
    if not target or not target.Character then return false end
    local targetPos = GetPredictedPosition(target)
    if not targetPos then return false end
    remote:FireServer(targetPos)
    return true
end

local function Fire()
    local target = GetClosestPlayer()
    if not target then return end
    local success = FireAtTarget(target)
    if success and fireBtn then
        TweenService:Create(fireBtn, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(0,255,100)}):Play()
        task.wait(0.08)
        TweenService:Create(fireBtn, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(60,20,80)}):Play()
    end
end

