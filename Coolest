--// ========== RAINBOW KNIFE ========== //
local function GetNextKnife()
    local knife = RainbowKnives[knifeIndex]
    knifeIndex = knifeIndex + 1
    if knifeIndex > #RainbowKnives then
        knifeIndex = 1
    end
    return knife
end

--// ========== DEĞİŞTİRİLEN YER: Rainbow Knife desteği ========== //
local function ThrowKnife(targetPos)
    local remote = GetKnifeRemote()
    if not remote then return false end
    local character = LocalPlayer.Character
    if not character then return false end
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return false end

    local origin = root.Position + Vector3.new(0, 1.5, 0)
    local lookAt = CFrame.lookAt(origin, targetPos)
    local handle = GetMapPart()
    if not handle then return false end

    -- Rainbow modu açıksa sıradaki bıçağı al, değilse seçili bıçağı kullan
    local knifeToUse = Settings.SelectedKnife
    if Settings.RainbowKnife then
        knifeToUse = GetNextKnife()
    end

    remote:InvokeServer(lookAt, targetPos, knifeToUse, handle)
    return true
end

