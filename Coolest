    if input.KeyCode == Enum.KeyCode.F then
        Fire()
    elseif input.KeyCode == Enum.KeyCode.L then
        Settings.KnifeAura = not Settings.KnifeAura
        if Settings.KnifeAura then
            KnifeLoop()
        else
            auraRunning = false
            DestroyCrosshair()
        end
    end
end)

